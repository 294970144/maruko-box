# ============================================================
# 小丸工具箱 (MarukoBox) — .gitignore
# 仓库只保留源码与构建脚本；所有二进制/构建产物均不入库
# ============================================================

# --- .NET / MSBuild 构建产物 ---
bin/
obj/
[Bb]in/
[Oo]bj/

# --- 安装包 / 发布产物（体积大，可用构建脚本一键重建）---
dist/
payload/
artifacts/

# --- 内置 ffmpeg 二进制源（jellyfin-ffmpeg 便携版 zip，92MB 级，不入库）---
# 构建安装包时由 build-installer.ps1 自动发现并解压进 payload\ffmpeg\
third_party/

# --- Visual Studio / Rider / IDE ---
.vs/
.idea/
*.user
*.suo
*.userprefs
.vsconfig

# --- Windows 应用打包（MSIX，本项目走 unpackaged） ---
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
*.appx
*.appxbundle
*.msix
*.msixbundle

# --- 日志 / 临时 ---
*.log
*.tmp

# --- 操作系统 ---
Thumbs.db
Desktop.ini
.DS_Store

# --- 注意：以下均保留入库 ---
#   *.cs  *.csproj  *.sln
#   Installer-Inno/*.iss  *.ps1
#   *.md  .gitignore

# --- build temp logs (shell redirect artifacts) ---
build_log.txt
