<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MarukoBox</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.8.0</Version>
    <AssemblyTitle>MarukoBox 2026</AssemblyTitle>
    <Product>MarukoBox 2026</Product>
    <!-- 让 exe 在资源管理器/任务栏(未运行时)显示图标：嵌入 RT_GROUP_ICON 到 PE -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 【D1 修复】移除 Microsoft.Windows.SDK.BuildTools.WinApp：
         它只服务于「packaged 应用的 dotnet run 调试注册」（winapp CLI / AUMID 身份），
         本应用已全面走 unpackaged（WindowsPackageType=None），启动调试用 F5/直启 exe，
         该包在 build / publish / run 三场景均无参与，属无用依赖。 -->
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    unpackaged 发布补丁

    问题：dotnet publish 不会把 WinUI 3 的两类关键产物复制到发布目录：
      (1) *.xbf  —— 编译后的 XAML（App.xbf、MainWindow.xbf、Pages/*.xbf）
      (2) 应用资源索引 —— Release 配置下生成的是 <AssemblyName>.pri，
          而 unpackaged 运行时只认 resources.pri
    缺失后果：unpackaged 应用启动即崩溃，事件日志报
      Microsoft.UI.Xaml.dll 异常 0xc000027b（XAML 资源/元数据加载失败）

    仅在 WindowsPackageType=None（unpackaged）时生效，不影响 MSIX 打包流程。
  -->
  <Target Name="CopyWinUIAssetsForUnpackagedPublish" AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_XbfToPublish Include="$(OutputPath)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_XbfToPublish)"
          DestinationFiles="@(_XbfToPublish->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pri"
          DestinationFiles="$(PublishDir)resources.pri"
          Condition="Exists('$(OutputPath)$(AssemblyName).pri')"
          SkipUnchangedFiles="true" />
    <!--
      AppIcon.ico 等 Assets 也是 Content，但 unpackaged 发布会把它们丢掉
      （与 .xbf/.pri 同类问题），导致 AppWindow.SetIcon("Assets/AppIcon.ico")
      与 TitleBar.IconSource 因文件缺失而静默失败 → 运行时/快捷方式全是无图标。
      这里显式把整个 Assets 目录补拷到发布目录。
    -->
    <ItemGroup>
      <_AssetsToPublish Include="$(OutputPath)Assets\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AssetsToPublish)"
          DestinationFiles="@(_AssetsToPublish->'$(PublishDir)Assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>

    <!--
      【M4】关闭裁剪，并与构建脚本的行为对齐。

      背景：Windows App SDK 1.2 起官方称 CsWinRT 投影「可裁剪」，但同一份 release notes
      也提醒「裁剪对反射有限制，发布裁剪版务必充分测试」；Microsoft Q&A 上的实际案例
      正是 WinUI 3 裁剪后启动崩溃（0xc000027b），根因是裁剪器对 x:Bind 生成代码与
      XAML 类型下手过重。本项目的会话 / 配置走运行时反射序列化，正是文档点名的高危模式。

      此前 Release 写的是 True，全靠 build-installer.ps1 的 -p:PublishTrimmed=false 压掉，
      在 IDE 里直接发布就会踩坑。这里显式关掉以消除分叉；
      若将来要重新启用，必须先跑通裁剪版的启动与会话保存。
    -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
