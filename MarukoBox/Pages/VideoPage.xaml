<Page
    x:Class="MarukoBox.Pages.VideoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarukoBox.Pages"
    xmlns:models="using:MarukoBox.Models"
    xmlns:conv="using:MarukoBox.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" NavigationCacheMode="Required">

    <Page.Resources>
        <conv:BoolToVisibility x:Key="BoolToVisibility" />
        <conv:InvertBool x:Key="InvertBool" />
        <conv:InvertBoolToVisibility x:Key="InvertBoolToVisibility" />
        <conv:UserLevelToVisibility x:Key="UserLevelToVisibility" />
        <conv:UserLevelEqualsToVisibility x:Key="UserLevelEqualsToVisibility" />
    </Page.Resources>

    <Grid ColumnSpacing="16" Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左：队列 ============ -->
        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Text="视频" Style="{StaticResource TitleTextBlockStyle}" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16"
                    AllowDrop="True" DragOver="DropZone_DragOver" Drop="DropZone_Drop">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE8B6;" FontSize="32" Opacity="0.5" />
                    <TextBlock Text="拖拽视频到此处" HorizontalAlignment="Center" Opacity="0.8" />
                    <Button Content="添加文件" Click="AddFiles_Click" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="清空" Command="{x:Bind ViewModel.ClearQueueCommand, Mode=OneWay}" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Content="{x:Bind ViewModel.Queue.Count, Mode=OneWay}" IsEnabled="False" />
            </Grid>

            <ListView ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}" MaxHeight="420">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:EncodeItem">
                        <Grid ColumnSpacing="8" Padding="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StatusText}" FontSize="12" Opacity="0.7" />
                                <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Height="4"
                                             Visibility="{x:Bind IsEncoding, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" FontSize="12"
                                    Click="RemoveItem_Click"
                                    DataContext="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- ============ 中：参数 ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

                <!-- 编码器 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="视频编码器" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{x:Bind ViewModel.SelectedEncoderOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>

                <!-- 质量（普通级专属：恒定质量四档，升级后由完整码率控制取代） -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelEqualsToVisibility}, ConverterParameter='Default'}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="质量" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.QualityPresetOptions, Mode=OneWay}"
                                  DisplayMemberPath="Name" SelectedValuePath="Value"
                                  SelectedValue="{x:Bind ViewModel.SelectedQualityPreset, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <TextBlock Text="恒定质量编码：文件大小由画面复杂度决定，质量越高越清晰、体积越大"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- GPU 参数面板 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{x:Bind ViewModel.ShowGpuPanel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="GPU 编码参数" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <!-- 码率控制（高手及以上） -->
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="码率控制" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.RateControlOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedRateControl, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <!-- CQP：恒定质量 -->
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.ShowGpuCqp, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="质量 (CQP，0=无损 51=最差)" Opacity="0.8" />
                            <NumberBox Value="{x:Bind ViewModel.Settings.Quality, Mode=TwoWay}"
                                       Minimum="0" Maximum="51" SmallChange="1" SpinButtonPlacementMode="Compact" />
                            <TextBlock Text="GPU 使用 CQP 恒定质量（等价于 CRF）。若要使用 CRF，请在上方编码器选择 x264 / x265（CPU）。"
                                       FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 码率类（高手及以上） -->
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <StackPanel Spacing="6"
                                        Visibility="{x:Bind ViewModel.ShowGpuBitrate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="目标码率 (kbps)" Opacity="0.8" />
                                <NumberBox Value="{x:Bind ViewModel.Settings.BitrateKbps, Mode=TwoWay}"
                                           Minimum="100" SmallChange="100" SpinButtonPlacementMode="Compact" />
                                <TextBlock Text="最大码率 (kbps)" Opacity="0.8" />
                                <NumberBox Value="{x:Bind ViewModel.Settings.MaxBitrateKbps, Mode=TwoWay}"
                                           Minimum="100" SmallChange="100" SpinButtonPlacementMode="Compact" />
                                <TextBlock Text="缓冲区 (kbps)" Opacity="0.8" />
                                <NumberBox Value="{x:Bind ViewModel.Settings.BufferSizeKbps, Mode=TwoWay}"
                                           Minimum="100" SmallChange="100" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="Preset (p1~p7)" Opacity="0.8" />
                            <NumberBox Value="{x:Bind ViewModel.Settings.GpuPreset, Mode=TwoWay}"
                                       Minimum="1" Maximum="7" SmallChange="1" SpinButtonPlacementMode="Compact" Width="160" />
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="Profile" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.ProfileOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                      Width="160" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="Tune" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.GpuTuneOptions, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedGpuTune, Mode=TwoWay}"
                                      Width="160" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- CPU 参数面板 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16"
                        Visibility="{x:Bind ViewModel.ShowCpuPanel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="CPU 编码参数" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                        <TextBlock Text="模式" Opacity="0.8" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.CpuModeOptions, Mode=OneWay}"
                                  DisplayMemberPath="Name" SelectedValuePath="Value"
                                  SelectedValue="{x:Bind ViewModel.SelectedCpuMode, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.ShowCpuCrf, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="CRF (0~51，越低越好)" Opacity="0.8" />
                        <NumberBox Value="{x:Bind ViewModel.Settings.Crf, Mode=TwoWay}"
                                   Minimum="0" Maximum="51" SmallChange="1" SpinButtonPlacementMode="Compact" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.ShowCpuBitrate, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="码率 (kbps)" Opacity="0.8" />
                            <NumberBox Value="{x:Bind ViewModel.Settings.BitrateKbps, Mode=TwoWay}"
                                       Minimum="100" SmallChange="100" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                        <TextBlock Text="Preset" Opacity="0.8" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.CpuPresetOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedCpuPreset, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Developer'}">
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.ShowCpuCustom, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="自定义 ffmpeg 视频参数" Opacity="0.8" />
                            <TextBox Text="{x:Bind ViewModel.CustomArgs, Mode=TwoWay}"
                                     PlaceholderText="-crf 18 -preset slow（仅视频编码器参数，不含 -i / -c:v / 输出）"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 通用：分辨率与输出 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="分辨率与输出" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch Header="保持原始分辨率" IsOn="{x:Bind ViewModel.KeepOriginalResolution, Mode=TwoWay}" />

                        <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.KeepOriginalResolution, Mode=OneWay, Converter={StaticResource InvertBoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" Header="宽度" Value="{x:Bind ViewModel.Settings.Width, Mode=TwoWay}" Minimum="0" />
                            <NumberBox Grid.Column="1" Header="高度" Value="{x:Bind ViewModel.Settings.Height, Mode=TwoWay}" Minimum="0" />
                        </Grid>

                        <StackPanel Spacing="6">
                            <TextBlock Text="容器格式" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.ContainerOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                      Width="160" HorizontalAlignment="Left" />
                        </StackPanel>

                        <!-- 音轨/字幕（高手及以上） -->
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="音轨" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.AudioOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedAudio, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="字幕" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.SubtitleOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedSubtitle, Mode=TwoWay}"
                                      Width="160" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ 右：输出与进度 ============ -->
        <StackPanel Grid.Column="2" Spacing="12">
            <TextBlock Text="输出与进度" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- 输出文件夹 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="输出文件夹" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}"
                                 PlaceholderText="留空则输出到源文件同目录" />
                        <Button Grid.Column="1" Content="浏览"
                                Command="{x:Bind ViewModel.BrowseOutputCommand, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />

                    <ProgressBar Value="{x:Bind ViewModel.Progress.Percent, Mode=OneWay}" Maximum="100" Height="8" />

                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="进度" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Percent, Mode=OneWay, FallbackValue=0}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="速度" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Speed, Mode=OneWay}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="帧率" Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Fps, Mode=OneWay}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="码率" Opacity="0.7" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Progress.BitrateKbps, Mode=OneWay}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="剩余" Opacity="0.7" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Remaining, Mode=OneWay}" HorizontalTextAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="开始编码" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.StartCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsEncoding, Mode=OneWay, Converter={StaticResource InvertBool}}"
                    HorizontalAlignment="Stretch" />

            <Button Content="取消" Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsEncoding, Mode=OneWay}"
                    HorizontalAlignment="Stretch" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="6">
                    <TextBlock Text="编码完成后" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.AfterOptions, Mode=OneWay}"
                              DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{x:Bind ViewModel.SelectedAfter, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="注：关机/休眠通过系统命令执行，执行前会弹出可取消的确认窗口（仅当全部编码成功时触发）。" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
