<Page
    x:Class="MarukoBox.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarukoBox.Pages"
    xmlns:models="using:MarukoBox.Models"
    xmlns:conv="using:MarukoBox.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" NavigationCacheMode="Required">

    <Page.Resources>
        <conv:BoolToInfoBarSeverity x:Key="BoolToInfoBarSeverity" />
        <conv:BoolToGlyph x:Key="BoolToGlyph" />
        <conv:BoolToVisibility x:Key="BoolToVisibility" />
        <conv:InvertBool x:Key="InvertBool" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="32" MaxWidth="760">

            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- 硬件检测状态条 -->
            <InfoBar
                Title="GPU 与 ffmpeg 检测"
                Message="{x:Bind ViewModel.GpuInfo.Summary, Mode=OneWay}"
                Severity="{x:Bind ViewModel.GpuInfo.DetectionSucceeded, Mode=OneWay, Converter={StaticResource BoolToInfoBarSeverity}}"
                IsOpen="True"
                IsClosable="False" />

            <!-- 6 项状态指示 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="硬件能力" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ffmpeg 版本" Opacity="0.8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.FfmpegVersion, Mode=OneWay}" />
                        <FontIcon Grid.Row="0" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.FfmpegFound, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="显卡型号" Opacity="0.8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.GpuName, Mode=OneWay}" />
                        <FontIcon Grid.Row="1" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.HasAnyGpuEncoder, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="驱动版本" Opacity="0.8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.DriverVersion, Mode=OneWay}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="NVENC API" Opacity="0.8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.NvencApiVersion, Mode=OneWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="scale_cuda" Opacity="0.8" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="全 GPU 缩放" />
                        <FontIcon Grid.Row="4" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.HasCudaScale, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="cuda 硬件解码" Opacity="0.8" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="-hwaccel cuda" />
                        <FontIcon Grid.Row="5" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.HasCudaDecode, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />
                    </Grid>

                    <Button Content="重新检测" Command="{x:Bind ViewModel.DetectCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsDetecting, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsDetecting, Mode=OneWay}" Width="20" Height="20"
                                  Visibility="{x:Bind ViewModel.IsDetecting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ffmpeg 路径 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="ffmpeg.exe 路径" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="选择 ffmpeg.exe 位置" />
                        <Button Grid.Column="1" Content="浏览…" Command="{x:Bind ViewModel.BrowseFfmpegCommand, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 编码默认参数 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="默认编码参数" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="默认编码器" Opacity="0.8" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{x:Bind ViewModel.SelectedEncoderOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="多 GPU 设备序号（0 = 自动）" Opacity="0.8" />
                        <NumberBox Value="{x:Bind ViewModel.GpuDevice, Mode=TwoWay}"
                                   Minimum="0" Maximum="3" SmallChange="1" SpinButtonPlacementMode="Compact"
                                   Width="160" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 界面与行为 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="界面与行为" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="主题" Opacity="0.8" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}"
                                  Width="200" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="编码完成后" Opacity="0.8" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.AfterCompletionOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.AfterCompletion, Mode=TwoWay}"
                                  Width="200" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="默认输出目录（留空则同目录）" Opacity="0.8" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Command="{x:Bind ViewModel.BrowseOutputCommand, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="保存配置" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" HorizontalAlignment="Left" />

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" />

        </StackPanel>
    </ScrollViewer>
</Page>
