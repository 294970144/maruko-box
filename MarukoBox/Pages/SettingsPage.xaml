<Page
    x:Class="MarukoBox.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarukoBox.Pages"
    xmlns:models="using:MarukoBox.Models"
    xmlns:conv="using:MarukoBox.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" NavigationCacheMode="Required">

    <Page.Resources>
        <conv:BoolToInfoBarSeverity x:Key="BoolToInfoBarSeverity" />
        <conv:BoolToGlyph x:Key="BoolToGlyph" />
        <conv:BoolToVisibility x:Key="BoolToVisibility" />
        <conv:InvertBool x:Key="InvertBool" />
        <conv:EmptyToCollapsed x:Key="EmptyToCollapsed" />
        <conv:UserLevelToVisibility x:Key="UserLevelToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="32" MaxWidth="760">

            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- 检查更新 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="24"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="检查更新" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LocalVersionText, Mode=OneWay}"
                                       Opacity="0.7" FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center">
                            <Button Content="检查更新" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.CheckUpdateCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                            <Button Content="检查依赖"
                                    Command="{x:Bind ViewModel.CheckDependenciesCommand, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.IsCheckingUpdate, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                        </StackPanel>
                    </Grid>

                    <!-- 更新源切换 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="更新源" Opacity="0.8" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.UpdateSourceOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedUpdateSource, Mode=TwoWay}"
                                  MinWidth="160" />
                    </StackPanel>

                    <!-- 下载进度（仅下载阶段可见） -->
                    <ProgressBar Value="{x:Bind ViewModel.UpdateProgressPercent, Mode=OneWay}"
                                 Maximum="100"
                                 IsIndeterminate="{x:Bind ViewModel.IsDownloading, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}"
                               Opacity="0.8" FontSize="12"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay, Converter={StaticResource EmptyToCollapsed}}" />
                </StackPanel>
            </Border>

            <!-- 硬件检测状态条 -->
            <InfoBar
                Title="GPU 与 ffmpeg 检测"
                Message="{x:Bind ViewModel.GpuInfo.Summary, Mode=OneWay}"
                Severity="{x:Bind ViewModel.GpuInfo.DetectionSucceeded, Mode=OneWay, Converter={StaticResource BoolToInfoBarSeverity}}"
                IsOpen="True"
                IsClosable="False" />

            <!-- 6 项状态指示 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="硬件能力" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ffmpeg 版本" Opacity="0.8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.FfmpegVersion, Mode=OneWay}" />
                        <FontIcon Grid.Row="0" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.FfmpegFound, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="显卡型号" Opacity="0.8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.GpuName, Mode=OneWay}" />
                        <FontIcon Grid.Row="1" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.HasAnyGpuEncoder, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="驱动版本" Opacity="0.8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.DriverVersion, Mode=OneWay}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="NVENC API" Opacity="0.8" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.GpuInfo.NvencApiVersion, Mode=OneWay}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="scale_cuda" Opacity="0.8" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="全 GPU 缩放" />
                        <FontIcon Grid.Row="4" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.HasCudaScale, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="cuda 硬件解码" Opacity="0.8" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="-hwaccel cuda" />
                        <FontIcon Grid.Row="5" Grid.Column="2" Glyph="{x:Bind ViewModel.GpuInfo.HasCudaDecode, Mode=OneWay, Converter={StaticResource BoolToGlyph}}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="内置 ffmpeg" Opacity="0.8" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.BundledVersionText, Mode=OneWay}" />
                    </Grid>

                    <Button Content="重新检测" Command="{x:Bind ViewModel.DetectCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsDetecting, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                    <ProgressRing IsActive="{x:Bind ViewModel.IsDetecting, Mode=OneWay}" Width="20" Height="20"
                                  Visibility="{x:Bind ViewModel.IsDetecting, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ffmpeg 路径（高手及以上；默认级别直接使用内置 ffmpeg，无需配置） -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16"
                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                <StackPanel Spacing="10">
                    <TextBlock Text="ffmpeg.exe 路径" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="留空 = 自动使用内置 ffmpeg" />
                        <Button Grid.Column="1" Content="浏览…" Command="{x:Bind ViewModel.BrowseFfmpegCommand, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 编码默认参数 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="默认编码参数" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="默认编码器" Opacity="0.8" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.EncoderOptions, Mode=OneWay}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{x:Bind ViewModel.SelectedEncoderOption, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="6"
                                Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                        <TextBlock Text="多 GPU 设备序号（0 = 自动）" Opacity="0.8" />
                        <NumberBox Value="{x:Bind ViewModel.GpuDevice, Mode=TwoWay}"
                                   Minimum="0" Maximum="3" SmallChange="1" SpinButtonPlacementMode="Compact"
                                   Width="160" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 主题（切换后重启生效） -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="24"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="主题" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="切换后需重启应用生效"
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                              ItemsSource="{x:Bind ViewModel.ThemeOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 保持习惯（即时生效，无需重启） -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="24"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="保持习惯" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="退出时记住视频页的编码设置，下次打开自动恢复，与上次完全一致；关闭后每次都用默认参数。即时生效"
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsOn="{x:Bind ViewModel.RememberLastSession, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 用户级别（切换后重启生效） -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" Glyph="&#xE716;" FontSize="24"
                              VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="用户级别" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="控制功能显示的详细程度：默认只显示常用功能，高手显示进阶参数，程序员显示全部。切换后需重启应用生效"
                                   Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox Grid.Column="2" MinWidth="150" VerticalAlignment="Center"
                              ItemsSource="{x:Bind ViewModel.UserLevelOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedUserLevel, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 界面与行为 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="界面与行为" Style="{StaticResource BodyStrongTextBlockStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="默认输出目录（留空则同目录）" Opacity="0.8" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Command="{x:Bind ViewModel.BrowseOutputCommand, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 「专家」专列：内置 ffmpeg 版本列表 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16"
                    Visibility="{x:Bind ViewModel.IsFfmpegListVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE7B8;" FontSize="24"
                                  VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="内置 ffmpeg 版本列表（专家）" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="可强制安装任意版本，不检查驱动兼容性；驱动不兼容时 NVENC 硬件编码可能不可用，但软件编码器照常使用"
                                       Opacity="0.7" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>

                        <Button Grid.Column="2" Content="刷新版本列表"
                                Command="{x:Bind ViewModel.RefreshFfmpegListCommand, Mode=OneWay}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.FfmpegReleaseRows, Mode=OneWay}"
                              SelectionMode="None"
                              MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FfmpegReleaseRow">
                                <Grid ColumnSpacing="12" Padding="4" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{x:Bind Tag}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind PublishedAtText}" Opacity="0.6" FontSize="11" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{x:Bind SizeText}" Opacity="0.8"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="2" Padding="6,2" CornerRadius="3"
                                            Background="#28E0A25E"
                                            Visibility="{x:Bind IsPrerelease, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="prerelease" FontSize="10" Foreground="#FFE0A25E" />
                                    </Border>

                                    <TextBlock Grid.Column="3" Text="{x:Bind CompatibleText}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />

                                    <Button Grid.Column="4" Content="安装此版本"
                                            Command="{x:Bind InstallCommand}"
                                            CommandParameter="{x:Bind Mode=OneWay}"
                                            IsEnabled="{x:Bind IsInstalling, Mode=OneWay, Converter={StaticResource InvertBool}}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <Button Content="保存配置" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.SaveCommand, Mode=OneWay}" HorizontalAlignment="Left" />

            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" />

        </StackPanel>
    </ScrollViewer>
</Page>
