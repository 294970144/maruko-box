<Page
    x:Class="MarukoBox.Pages.MuxPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarukoBox.Pages"
    xmlns:models="using:MarukoBox.Models"
    xmlns:conv="using:MarukoBox.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" NavigationCacheMode="Required">

    <Page.Resources>
        <conv:MuxKindToBrush x:Key="MuxKindToBrush" />
        <conv:BoolToVisibility x:Key="BoolToVisibility" />
        <conv:InvertBool x:Key="InvertBool" />
        <conv:InvertBoolToVisibility x:Key="InvertBoolToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24">
            <StackPanel>
                <TextBlock Text="封装" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="合并视频 / 音频 / 字幕轨道到指定容器（无损 -c copy）" Opacity="0.7" />
            </StackPanel>

            <!-- 容器格式 + 输出路径 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="容器格式" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.ContainerOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="输出路径" Opacity="0.8" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputPath, Mode=TwoWay}"
                                         PlaceholderText="留空则自动生成到源文件同目录" />
                                <Button Grid.Column="1" Content="浏览…" Click="BrowseOutput_Click" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 轨道列表 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="轨道列表" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button Grid.Column="1" Content="清空" Command="{x:Bind ViewModel.ClearInputsCommand, Mode=OneWay}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Inputs, Mode=OneWay}" MaxHeight="360"
                              Visibility="{x:Bind ViewModel.HasInputs, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MuxInput">
                                <Grid ColumnSpacing="12" Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Background="{x:Bind Kind, Mode=OneWay, Converter={StaticResource MuxKindToBrush}}"
                                            CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind KindLabel}" FontSize="12" Foreground="Black" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FileName}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Content="✕" FontSize="12"
                                            Click="RemoveInput_Click" DataContext="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="尚未添加输入文件，请使用下方按钮添加视频 / 音频 / 字幕"
                               Opacity="0.6"
                               Visibility="{x:Bind ViewModel.HasInputs, Mode=OneWay, Converter={StaticResource InvertBoolToVisibility}}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+ 添加视频" Click="AddVideo_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="1" Content="+ 添加音频" Click="AddAudio_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2" Content="+ 添加字幕" Click="AddSubtitle_Click" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作 + 进度 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Button Content="开始封装" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.StartCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBool}}"
                            HorizontalAlignment="Stretch" />

                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />

                    <ProgressBar Value="{x:Bind ViewModel.Progress.Percent, Mode=OneWay}" Maximum="100" Height="8" />

                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="进度" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Percent, Mode=OneWay, FallbackValue=0}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="速度" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Speed, Mode=OneWay}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="码率" Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Progress.BitrateKbps, Mode=OneWay}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="剩余" Opacity="0.7" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Remaining, Mode=OneWay}" HorizontalTextAlignment="Right" />
                    </Grid>

                    <Button Content="取消" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
