<Page
    x:Class="MarukoBox.Pages.AudioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MarukoBox.Pages"
    xmlns:models="using:MarukoBox.Models"
    xmlns:conv="using:MarukoBox.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RootPage"
    mc:Ignorable="d" NavigationCacheMode="Required">

    <Page.Resources>
        <conv:BoolToVisibility x:Key="BoolToVisibility" />
        <conv:InvertBool x:Key="InvertBool" />
        <conv:InvertBoolToVisibility x:Key="InvertBoolToVisibility" />
        <conv:UserLevelToVisibility x:Key="UserLevelToVisibility" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="24">
            <StackPanel>
                <TextBlock Text="音频处理" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="独立音频转码 · 支持批量" Opacity="0.7" />
            </StackPanel>

            <!-- 转码参数 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="转码参数" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock Text="编码器" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.CodecOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedCodec, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="比特率" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.BitrateOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedBitrate, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <!-- 声道/采样率（高手及以上） -->
                        <StackPanel Grid.Column="2" Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="声道" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.ChannelOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedChannels, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Spacing="6"
                                    Visibility="{x:Bind ViewModel.UserLevel, Mode=OneWay, Converter={StaticResource UserLevelToVisibility}, ConverterParameter='Expert'}">
                            <TextBlock Text="采样率" Opacity="0.8" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.SampleRateOptions, Mode=OneWay}"
                                      DisplayMemberPath="Name" SelectedValuePath="Value"
                                      SelectedValue="{x:Bind ViewModel.SelectedSampleRate, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.TargetSummary, Mode=OneWay}"
                               FontSize="12" Opacity="0.7" />
                </StackPanel>
            </Border>

            <!-- 输出文件夹 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <TextBlock Text="输出文件夹" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDir, Mode=TwoWay}"
                                 PlaceholderText="留空则输出到源文件同目录" />
                        <Button Grid.Column="1" Content="浏览"
                                Command="{x:Bind ViewModel.BrowseOutputCommand, Mode=OneWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 队列 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="音频队列" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <Button Grid.Column="1" Content="添加文件" Click="AddFiles_Click" />
                        <Button Grid.Column="2" Content="清空" Command="{x:Bind ViewModel.ClearQueueCommand, Mode=OneWay}" />
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}" MaxHeight="360"
                              Visibility="{x:Bind ViewModel.HasQueue, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EncodeItem">
                                <Grid ColumnSpacing="12" Padding="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Opacity="0.7"
                                                   Text="{Binding ElementName=RootPage, Path=ViewModel.TargetSummary}" />
                                        <ProgressBar Value="{x:Bind Percent, Mode=OneWay}" Maximum="100" Height="4"
                                                     Visibility="{x:Bind IsEncoding, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="8,3">
                                        <TextBlock Text="{x:Bind StatusText}" FontSize="12" Foreground="White" />
                                    </Border>
                                    <Button Grid.Column="2" Content="✕" FontSize="12"
                                            Click="RemoveItem_Click" DataContext="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Text="队列为空，请点击「添加文件」"
                               Opacity="0.6"
                               Visibility="{x:Bind ViewModel.HasQueue, Mode=OneWay, Converter={StaticResource InvertBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 操作 + 进度 -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="12">
                    <Button Content="开始转码" Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.StartCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource InvertBool}}"
                            HorizontalAlignment="Stretch" />

                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />

                    <ProgressBar Value="{x:Bind ViewModel.Progress.Percent, Mode=OneWay}" Maximum="100" Height="8" />

                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="进度" Opacity="0.7" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Percent, Mode=OneWay, FallbackValue=0}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="速度" Opacity="0.7" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Speed, Mode=OneWay}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="码率" Opacity="0.7" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Progress.BitrateKbps, Mode=OneWay}" HorizontalTextAlignment="Right" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="剩余" Opacity="0.7" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.Progress.Remaining, Mode=OneWay}" HorizontalTextAlignment="Right" />
                    </Grid>

                    <Button Content="取消" HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.CancelCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
