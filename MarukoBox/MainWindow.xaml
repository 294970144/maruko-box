<Window
    x:Class="MarukoBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MarukoBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MarukoBox 2026"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 导航窗格拖拽调宽（v1.9.1 根网格热区方案）：不再用独立命中窄条——
         整个根网格监听指针，按「指针 X 距窗格右缘 ≤6px」判定热区：
         热区内显示左右调整光标，按下开始拖拽（捕获指针）。
         v1.9.0 的 10px Border 方案死于：PointerEntered 把 Background 换成
         Application.Resources 里找不到的画刷（null）→ 元素失去命中测试，
         首次悬停后热区即失效，Pressed/Moved 永不触发。 -->
    <Grid x:Name="RootGrid"
          PointerMoved="RootGrid_PointerMoved"
          PointerPressed="RootGrid_PointerPressed"
          PointerReleased="RootGrid_PointerReleased"
          PointerCanceled="RootGrid_PointerCanceled"
          PointerCaptureLost="RootGrid_PointerCaptureLost">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="MarukoBox 2026">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- 官方推荐导航范式：NavigationView + Frame -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="视频" Tag="Video" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Video" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="音频" Tag="Audio">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Audio" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="封装" Tag="Mux">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="字幕" Tag="Subtitle">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Font" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="抽取" Tag="Extract">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Download" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="图片" Tag="Image">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="工具" Tag="Tools">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Repair" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="裁剪" Tag="Trim">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Crop" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 功能菜单 / 系统菜单 分组分隔（结构化认知：上方为功能入口，下方为系统入口） -->
                <NavigationViewItemSeparator />

                <NavigationViewItem Tag="Settings">
                    <NavigationViewItem.Content>
                        <!-- 标题 + 新版徽标：启动自动检查发现新版本时点亮（SetUpdateAvailable） -->
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="设置" />
                            <InfoBadge x:Name="UpdateAvailableBadge"
                                       Style="{ThemeResource AttentionDotInfoBadgeStyle}"
                                       Visibility="Collapsed"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </NavigationViewItem.Content>
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                    <!-- 重启提醒：主题 / 用户级别改后选了「稍后重启」时点亮 -->
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="RestartPendingBadge"
                                   Style="{ThemeResource AttentionDotInfoBadgeStyle}"
                                   Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="About">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
