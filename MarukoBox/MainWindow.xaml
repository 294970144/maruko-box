<Window
    x:Class="MarukoBox.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:MarukoBox.Helpers"
    xmlns:local="using:MarukoBox"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:MarukoBox.Models"
    Title="MarukoBox 2026"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!-- 导航窗格拖拽调宽（v1.9.1 根网格热区方案）：不再用独立命中窄条——
         整个根网格监听指针，按「指针 X 距窗格右缘 ≤6px」判定热区：
         热区内显示左右调整光标，按下开始拖拽（捕获指针）。
         v1.9.0 的 10px Border 方案死于：PointerEntered 把 Background 换成
         Application.Resources 里找不到的画刷（null）→ 元素失去命中测试，
         首次悬停后热区即失效，Pressed/Moved 永不触发。 -->
    <Grid x:Name="RootGrid"
          PointerMoved="RootGrid_PointerMoved"
          PointerPressed="RootGrid_PointerPressed"
          PointerReleased="RootGrid_PointerReleased"
          PointerCanceled="RootGrid_PointerCanceled"
          PointerCaptureLost="RootGrid_PointerCaptureLost">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="MarukoBox 2026">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- 官方推荐导航范式：NavigationView 外壳 + Frame。
             侧栏菜单项改为 PaneCustomContent 里的 ListView：NavigationView 的菜单区
             内部是 ItemsRepeater，没有内置重排与让位动画（自绘拖拽必然跳格生硬）；
             ListView 有官方 drag-reorder（CanDragItems/AllowDrop/CanReorderItems），
             自带「被拖项跟随鼠标」的拖动视觉、插入指示线与平滑让位动画。 -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            Loaded="NavView_Loaded">

            <NavigationView.Resources>
                <!-- 功能页项模板 -->
                <DataTemplate x:Key="NavFeatureTemplate" x:DataType="models:NavItemModel">
                    <Grid ColumnSpacing="14" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- SymbolIcon 无 FontSize 属性（那是 FontIcon 的），用 Viewbox 缩到导航项图标尺寸 16px -->
                        <Viewbox
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center">
                            <SymbolIcon Symbol="{x:Bind Icon}" />
                        </Viewbox>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{x:Bind Label}" />
                    </Grid>
                </DataTemplate>

                <!-- 固定系统项模板（设置 / 关于）：设置项上方带分组分隔线，尾部带新版 / 重启徽标 -->
                <DataTemplate x:Key="NavSystemTemplate" x:DataType="models:NavItemModel">
                    <StackPanel>
                        <Rectangle
                            Height="1"
                            Margin="0,8,0,8"
                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Visibility="{x:Bind DividerVisibility, Mode=OneWay}" />
                        <Grid ColumnSpacing="14" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Viewbox
                                Width="16"
                                Height="16"
                                VerticalAlignment="Center">
                                <SymbolIcon Symbol="{x:Bind Icon}" />
                            </Viewbox>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{x:Bind Label}" />
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <!-- 新版提醒：启动自动检查发现新版本时点亮 -->
                                <InfoBadge
                                    Style="{ThemeResource AttentionDotInfoBadgeStyle}"
                                    Visibility="{x:Bind UpdateBadgeVisibility, Mode=OneWay}" />
                                <!-- 重启提醒：主题 / 用户级别改后选「稍后重启」时点亮 -->
                                <InfoBadge
                                    Style="{ThemeResource AttentionDotInfoBadgeStyle}"
                                    Visibility="{x:Bind RestartBadgeVisibility, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </DataTemplate>

                <helpers:NavItemTemplateSelector
                    x:Key="NavItemSelector"
                    Feature="{StaticResource NavFeatureTemplate}"
                    System="{StaticResource NavSystemTemplate}" />

                <!-- 项容器样式：只做「轻量样式」（Lightweight styling）——仅设属性 Setter，
                     **绝不替换 ControlTemplate**。
                     原因（踩坑实录）：WinUI 的 ListViewItem 视觉由 ListViewItemPresenter 提供，
                     选中 / 悬停 / 以及拖拽重排的「拖起视觉 + 让位动画」都由它内部实现；
                     一旦换成自定义 ControlTemplate（Grid+ContentPresenter），这些内置行为全部丢失，
                     表现为「源项呆在原地不动、邻居瞬移，拖动卡与残留卡片重叠」。
                     另：WinUI 3 默认 ListViewItem 自带左缘选中竖条（与 NavigationViewItem 观感一致），
                     无需自行复刻。
                     注意 MinHeight 而非 Height：系统项因带分隔线更高，需自适应。 -->
                <Style x:Key="NavListItemStyle" TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="40" />
                    <!-- Padding 经 TemplateBinding 传给 ListViewItemPresenter 的 ContentMargin -->
                    <Setter Property="Padding" Value="10,0,10,0" />
                    <Setter Property="Margin" Value="4,0,4,2" />
                    <Setter Property="CornerRadius" Value="4" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </NavigationView.Resources>

            <NavigationView.PaneCustomContent>
                <!-- 侧栏菜单：功能页（可拖拽重排）+ 固定系统项（设置 / 关于，不可拖）。
                     三件套缺一不可：CanDragItems 起拖、AllowDrop 接受放置、
                     CanReorderItems 让落在列表内时按插入位置重排（并自动更新 ItemsSource）。
                     数据源必须 ObservableCollection（List 不会自动更新顺序），
                     ItemsPanel 必须实现 IInsertionPanel（默认面板满足，勿换自定义面板）。 -->
                <ListView
                    x:Name="FeatureList"
                    Padding="0,2,0,2"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="FeatureList_DragItemsCompleted"
                    DragItemsStarting="FeatureList_DragItemsStarting"
                    ItemContainerStyle="{StaticResource NavListItemStyle}"
                    ItemTemplateSelector="{StaticResource NavItemSelector}"
                    SelectionChanged="FeatureList_SelectionChanged"
                    SelectionMode="Single" />
            </NavigationView.PaneCustomContent>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
