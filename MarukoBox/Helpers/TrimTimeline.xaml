<UserControl
    x:Class="MarukoBox.Helpers.TrimTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 时间轴：整条轨道 + 两个可拖动的区间端点 + 当前播放位置指针 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 拖动时跟着手指走的时间气泡 -->
        <Border x:Name="Bubble"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="6,2"
                Visibility="Collapsed">
            <TextBlock x:Name="BubbleText"
                       FontSize="12"
                       FontFamily="Consolas"
                       IsTextScaleFactorEnabled="False" />
        </Border>

        <Canvas x:Name="Track"
                Grid.Row="1"
                Height="34"
                Margin="0,4,0,0"
                Background="Transparent"
                PointerPressed="Track_PointerPressed"
                PointerMoved="Track_PointerMoved"
                PointerReleased="Track_PointerReleased"
                PointerCanceled="Track_PointerReleased">

            <!-- 底轨 -->
            <Rectangle x:Name="TrackBase"
                       Height="8"
                       RadiusX="4"
                       RadiusY="4"
                       Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                       Opacity="0.45" />

            <!-- 选中区间（两端之间的高亮段） -->
            <Rectangle x:Name="SelectionRect"
                       Height="8"
                       RadiusX="4"
                       RadiusY="4"
                       Fill="{ThemeResource AccentFillColorDefaultBrush}" />

            <!-- 当前播放位置指针 -->
            <Rectangle x:Name="Playhead"
                       Width="2"
                       Height="26"
                       Fill="White"
                       Opacity="0.9" />

            <!-- 起点端点：竖向握把 -->
            <Border x:Name="ThumbStart"
                    Width="14"
                    Height="28"
                    CornerRadius="7"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderBrush="White"
                    BorderThickness="2" />

            <!-- 终点端点 -->
            <Border x:Name="ThumbEnd"
                    Width="14"
                    Height="28"
                    CornerRadius="7"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    BorderBrush="White"
                    BorderThickness="2" />

            <!-- 两侧未选中的暗色遮罩，让选中区间一眼可见 -->
            <Rectangle x:Name="DimLeft"
                       Height="8"
                       RadiusX="4"
                       RadiusY="4"
                       Fill="Black"
                       Opacity="0.5" />
            <Rectangle x:Name="DimRight"
                       Height="8"
                       RadiusX="4"
                       RadiusY="4"
                       Fill="Black"
                       Opacity="0.5" />
        </Canvas>
    </Grid>
</UserControl>
