<Project Sdk="Microsoft.NET.Sdk">

  <!--
    小丸工具箱 2026 —— 零 UAC / 零证书 自解压安装程序

    设计要点：
    1. Native AOT 编译：安装器自身编译为原生 exe（~8MB），在没有 .NET 的机器上也能双击运行，
       且不携带运行时 —— 比 self-contained 单文件（约 70MB）小得多。
       前提：本机已装 VS「使用 C++ 的桌面开发」工作负载（link.exe 在 D:\VS2022\BuildTools\VC\...）。
       说明：AOT 下无内置 COM 互操作，故快捷方式改用 PowerShell 脚本文件（WScript.Shell）创建，未走 dynamic COM。
    2. payload 不嵌入程序集：271MB 的程序文件嵌为资源会让编译极慢且吃内存。
       改为编译后把 payload.zip 追加到 exe 文件末尾（PE 文件忽略尾部附加数据），
       运行时从自身尾部按 magic + 长度定位并解压 —— 自解压安装包的经典做法。

    构建流程见 build-installer.ps1：publish(AOT) -> 压缩 payload -> 追加到 exe 末尾
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MarukoBoxSetup</AssemblyName>
    <RootNamespace>MarukoBoxSetup</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
